				</outerBoundaryIs>
			</Polygon>
		</Placemark>
		<atom:link rel="app" href="https://www.google.com/earth/about/versions/#earth-pro" title="Google Earth Pro 7.3.7.1155"></atom:link>
	</Folder>
</Document>
</kml>
